[Unit]
Description=helpbuoy relay
Documentation=https://github.com/mevdschee/helpbuoy
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=helpbuoy-relay
Group=helpbuoy-relay
Environment=HELPBUOY_RELAY_STATE=/var/lib/helpbuoy-relay
Environment=HELPBUOY_RELAY_LISTEN=:5959
EnvironmentFile=-/etc/default/helpbuoy-relay
ExecStart=/usr/bin/helpbuoy-relay serve --listen ${HELPBUOY_RELAY_LISTEN}
Restart=on-failure
RestartSec=5

StateDirectory=helpbuoy-relay
StateDirectoryMode=0700
UMask=0077

# The relay only needs its state directory and the network. A port below
# 1024 (e.g. 443) needs: systemctl edit helpbuoy-relay, then under [Service]
# AmbientCapabilities=CAP_NET_BIND_SERVICE and
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
