[Unit]
Description=helpbuoy server
Documentation=https://github.com/helpbuoy/helpbuoy
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=helpbuoy-server
Group=helpbuoy-server
Environment=HELPBUOY_SERVER_STATE=/var/lib/helpbuoy-server
Environment=HELPBUOY_SERVER_MODE=http
Environment=HELPBUOY_SERVER_OPTS=
EnvironmentFile=-/etc/default/helpbuoy-server
ExecStart=/usr/bin/helpbuoy-server serve $HELPBUOY_SERVER_OPTS
Restart=on-failure
RestartSec=5

StateDirectory=helpbuoy-server
StateDirectoryMode=0700
UMask=0077

# The server only needs its state directory and the network. A port below
# 1024 (e.g. 443 in https mode) needs: systemctl edit helpbuoy-server, then under [Service]
# AmbientCapabilities=CAP_NET_BIND_SERVICE and
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
