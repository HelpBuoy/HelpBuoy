#!/bin/sh
# helpbuoy-serverctl runs an helpbuoy-server admin command on the state of the system
# server (/var/lib/helpbuoy-server), as the helpbuoy-server user, so files it writes stay
# readable by the service. Examples:
#
#   sudo helpbuoy-serverctl techie add alice 'ssh-ed25519 AAAA...'
#   sudo helpbuoy-serverctl techie list
#   sudo helpbuoy-serverctl computer list
#   sudo helpbuoy-serverctl hostkey
#
# A running server picks up changes within a second.
set -e
if [ "$(id -u)" -ne 0 ]; then
	echo "helpbuoy-serverctl: run it as root, e.g. sudo helpbuoy-serverctl $*" >&2
	exit 1
fi
cd /
exec runuser -u helpbuoy-server -- env HELPBUOY_SERVER_STATE=/var/lib/helpbuoy-server /usr/bin/helpbuoy-server "$@"
