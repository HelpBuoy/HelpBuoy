#!/bin/sh
# helpbuoy-serverctl runs an helpbuoy-server admin command on the state of the system
# server (/var/lib/helpbuoy-server), as the helpbuoy-server user, so files it writes stay
# readable by the service. Examples:
#
#   sudo helpbuoy-serverctl techie add alice 'ssh-ed25519 AAAA...'
#   sudo helpbuoy-serverctl techie list
#   sudo helpbuoy-serverctl computer list
#   sudo helpbuoy-serverctl hostkey
#   sudo helpbuoy-serverctl vhost add acme.helpbuoy.example.com
#   sudo helpbuoy-serverctl techie list --vhost acme.helpbuoy.example.com
#
# A running server picks up changes within a second.
set -e
if [ "$(id -u)" -ne 0 ]; then
	echo "helpbuoy-serverctl: run it as root, e.g. sudo helpbuoy-serverctl $*" >&2
	exit 1
fi
# With virtual hosts (HELPBUOY_SERVER_VHOSTS in /etc/default/helpbuoy-server),
# commands take --vhost NAME.
HELPBUOY_SERVER_VHOSTS=
if [ -r /etc/default/helpbuoy-server ]; then
	. /etc/default/helpbuoy-server
fi
cd /
exec runuser -u helpbuoy-server -- env HELPBUOY_SERVER_STATE=/var/lib/helpbuoy-server \
	HELPBUOY_SERVER_VHOSTS="$HELPBUOY_SERVER_VHOSTS" /usr/bin/helpbuoy-server "$@"
