#!/bin/sh
# hmw-relayctl runs an hmw-relay admin command on the state of the system
# relay (/var/lib/hmw-relay), as the hmw-relay user, so files it writes stay
# readable by the service. Examples:
#
#   sudo hmw-relayctl helper add alice --display "Alice" 'ssh-ed25519 AAAA...'
#   sudo hmw-relayctl helper list
#   sudo hmw-relayctl client list
#   sudo hmw-relayctl hostkey
#
# A running relay picks up changes within a second.
set -e
if [ "$(id -u)" -ne 0 ]; then
	echo "hmw-relayctl: run it as root, e.g. sudo hmw-relayctl $*" >&2
	exit 1
fi
cd /
exec runuser -u hmw-relay -- env HMW_RELAY_STATE=/var/lib/hmw-relay /usr/bin/hmw-relay "$@"
