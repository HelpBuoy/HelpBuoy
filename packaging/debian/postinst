#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
	systemd-sysusers helpbuoy-relay.conf
	install -d -o helpbuoy-relay -g helpbuoy-relay -m 0700 /var/lib/helpbuoy-relay
fi

# Same as what dh_installsystemd generates.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
	# was-enabled defaults to true, so a new installation enables the unit.
	if deb-systemd-helper --quiet was-enabled 'helpbuoy-relay.service'; then
		deb-systemd-helper enable 'helpbuoy-relay.service' >/dev/null || true
	else
		deb-systemd-helper update-state 'helpbuoy-relay.service' >/dev/null || true
	fi
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			action=restart
		else
			action=start
		fi
		deb-systemd-invoke $action 'helpbuoy-relay.service' >/dev/null || true
	fi
fi

exit 0
