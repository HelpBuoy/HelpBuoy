#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
	systemd-sysusers helpbuoy-server.conf
	install -d -o helpbuoy-server -g helpbuoy-server -m 0700 /var/lib/helpbuoy-server
fi

# Same as what dh_installsystemd generates.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
	# was-enabled defaults to true, so a new installation enables the unit.
	for unit in helpbuoy-server.service helpbuoy-server-admin.socket; do
		# Removing the package masks the units (postrm); installing it again
		# must take that mask off, or the service can't start.
		deb-systemd-helper unmask "$unit" >/dev/null || true
		if deb-systemd-helper --quiet was-enabled "$unit"; then
			deb-systemd-helper enable "$unit" >/dev/null || true
		else
			deb-systemd-helper update-state "$unit" >/dev/null || true
		fi
	done
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			action=restart
		else
			action=start
		fi
		deb-systemd-invoke $action 'helpbuoy-server.service' 'helpbuoy-server-admin.socket' >/dev/null || true
	fi
fi

#APT_SOURCE#

exit 0
