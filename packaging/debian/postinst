#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
	systemd-sysusers helpbuoy-server.conf
	install -d -o helpbuoy-server -g helpbuoy-server -m 0700 /var/lib/helpbuoy-server
fi

# Same as what dh_installsystemd generates.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
	# was-enabled defaults to true, so a new installation enables the unit.
	if deb-systemd-helper --quiet was-enabled 'helpbuoy-server.service'; then
		deb-systemd-helper enable 'helpbuoy-server.service' >/dev/null || true
	else
		deb-systemd-helper update-state 'helpbuoy-server.service' >/dev/null || true
	fi
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			action=restart
		else
			action=start
		fi
		deb-systemd-invoke $action 'helpbuoy-server.service' >/dev/null || true
	fi
fi

exit 0
