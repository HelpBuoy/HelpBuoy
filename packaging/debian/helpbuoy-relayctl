#!/bin/sh
# helpbuoy-relayctl runs an helpbuoy-relay admin command on the state of the system
# relay (/var/lib/helpbuoy-relay), as the helpbuoy-relay user, so files it writes stay
# readable by the service. Examples:
#
#   sudo helpbuoy-relayctl helper add alice 'ssh-ed25519 AAAA...'
#   sudo helpbuoy-relayctl helper list
#   sudo helpbuoy-relayctl client list
#   sudo helpbuoy-relayctl hostkey
#
# A running relay picks up changes within a second.
set -e
if [ "$(id -u)" -ne 0 ]; then
	echo "helpbuoy-relayctl: run it as root, e.g. sudo helpbuoy-relayctl $*" >&2
	exit 1
fi
cd /
exec runuser -u helpbuoy-relay -- env HELPBUOY_RELAY_STATE=/var/lib/helpbuoy-relay /usr/bin/helpbuoy-relay "$@"
