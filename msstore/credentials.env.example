# Partner Center credentials for msstore/publish.sh. Copy this file to
# msstore/credentials.env (git ignores it), fill it in and keep it private:
#
#   cp msstore/credentials.env.example msstore/credentials.env
#   chmod 600 msstore/credentials.env
#
# The values come from Partner Center, see "Publishing updates" in
# msstore/README.md. The client secret expires; put the new one here.

# Account settings, Organization profile, Tenants (the directory ID).
MSSTORE_TENANT_ID=
# Account settings, Legal info, Developer: Seller ID.
MSSTORE_SELLER_ID=
# Account settings, User management, Microsoft Entra applications: the
# application (client) ID of the app with the Manager role.
MSSTORE_CLIENT_ID=
# A client secret of that application.
MSSTORE_CLIENT_SECRET=
