<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI for the Windows client, built with wixl (msitools) by "make msi":
  wixl -a x64 -D Version=x.y.z -D FileVersion=x.y.z.b -D ExePath=... -D IconPath=... -o out.msi help-me-win.wxs
  It installs per user, without admin rights, into %LOCALAPPDATA%\Programs\help-me-win.
  The state stays in %LOCALAPPDATA%\help-me-win, shared with the portable exe.
  The UpgradeCode must never change, so new versions replace old ones.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="help-me-win" Language="1033" Version="$(var.Version)"
           Manufacturer="Maurits van der Schee" UpgradeCode="A3182225-098E-4C63-8855-57925CF25A30">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="help-me-win $(var.Version)" Comments="Remote support client for Windows"/>
    <Media Id="1" Cabinet="helpmewin.cab" EmbedCab="yes"/>
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of help-me-win is already installed."/>

    <Icon Id="help_me_win.ico" SourceFile="$(var.IconPath)"/>
    <Property Id="ARPPRODUCTICON" Value="help_me_win.ico"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mevdschee/help-me-win"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="help-me-win">
            <!-- Per-user components need a registry key path, not the file. -->
            <Component Id="MainExecutable" Guid="*" Win64="yes">
              <!-- The version must be set: an unversioned file never replaces
                   the versioned exe of the old install during an upgrade, and
                   removing the old version then deletes it. -->
              <File Id="help_me_win.exe" Name="help-me-win.exe" Source="$(var.ExePath)"
                    DefaultVersion="$(var.FileVersion)"/>
              <RemoveFolder Id="RemoveInstallDir" On="uninstall"/>
              <RegistryValue Root="HKCU" Key="Software\help-me-win" Name="exe"
                             Type="integer" Value="1" KeyPath="yes"/>
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="helpMeWinShortcut" Name="help-me-win" Description="Remote support client"
                    Target="[INSTALLDIR]help-me-win.exe" WorkingDirectory="INSTALLDIR"/>
          <RegistryValue Root="HKCU" Key="Software\help-me-win" Name="shortcut"
                         Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Product>
</Wix>
